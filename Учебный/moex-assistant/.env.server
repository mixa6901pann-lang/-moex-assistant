# Server configuration template — copy to `.env` on the server and fill secrets.
# Do NOT put real keys into this file: it is tracked by git.
VK_ENABLED=false

# LLM provider: yandex recommended for Russia; ollama/gemma used as local fallback and for geo-risk.
LLM_PROVIDER=yandex
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# Порядок fallback между провайдерами.
LLM_FALLBACK_ORDER=anthropic,gemini,yandex,ollama

# Локальная Ollama (используется как fallback/critic или основной провайдер).
# На сервере 4 CPU / 8 GB RAM рекомендуется gemma3:4b (~3 GB RAM).
# gemma3:12b на 8 GB будет работать впритык и может уходить в swap — не рекомендуется.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Для ускорения на CPU можно уменьшить до 2048; 4096 — баланс качества/скорости.
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=180.0

# Risk settings
MAX_POSITION_PCT=2.0
MAX_OPEN_POSITIONS=15
# Max position value as % of equity. Prevents over-concentration in one ticker.
MAX_POSITION_SIZE_PCT=5.0
# Min position value as % of equity. Filters out tiny/test positions.
MIN_POSITION_SIZE_PCT=0.5
STOP_LOSS_ATR_MULT=1.5
TRAILING_STOP_ATR_MULT=1.8
TARGET_RR=1.5

# Overnight carry fee model. Default uses T-Bank "Trader" fixed tiers from screenshot.
# Set to a percentage (e.g. 10) to use simple percent-of-notional model instead.
OVERNIGHT_CARRY_FEE_PCT=0.0

# Health endpoint
HEALTH_PORT=8080

# Web UI — по умолчанию отключена на сервере.
# Чтобы включить, установи WEB_UI_ENABLED=true и обязательно задай API_KEY.
WEB_UI_ENABLED=false

# API key для защиты write-эндпоинтов.
# Сгенерируй на сервере: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_random_api_key_here

# CodeAct — выполнение Python-кода из ответов LLM. На сервере оставь false.
CODEACT_ENABLED=false

# Tinkoff sandbox settings. For the 27 July 2026 experiment use sandbox=true,
# paper=false, semi_auto=true, auto_trading=false.
TINKOFF_SANDBOX=true
PAPER_TRADING=false
SEMI_AUTO_TRADING=true
AUTO_TRADING_ENABLED=false
SANDBOX_STARTING_CAPITAL=50000

# CBR key-rate meeting dates (ISO). New positions are blocked on the meeting day
# and the previous trading day; profit protection is tightened.
# Official 2026 schedule: 9 Feb, 23 Mar, 27 Apr, 15 Jun, 27 Jul, 14 Sep, 26 Oct, 14 Dec.
CBR_MEETING_DATES=2026-02-09,2026-03-23,2026-04-27,2026-06-15,2026-09-14,2026-10-26,2026-12-14
CBR_SOFT_MODE_ENABLED=true
