# VKontakte (опционально)
VK_ACCESS_TOKEN=your_vk_token_here
VK_GROUP_ID=your_group_id
VK_ENABLED=false

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_PROXY=

# LLM-провайдер: anthropic, ollama, gemini, yandex, none
# Рекомендуется yandex для сервера/России и ollama для локальных экспериментов.
LLM_PROVIDER=yandex

# Anthropic (если выбран LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Ollama (если выбран LLM_PROVIDER=ollama или используется fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Для ускорения на CPU можно уменьшить до 2048.
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=180.0

# Google Gemini (если выбран LLM_PROVIDER=gemini)
# Бесплатный ключ можно получить в https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# YandexGPT (если выбран LLM_PROVIDER=yandex)
# Ключ и folder_id создаются в Yandex Cloud: https://yandex.cloud/ru/docs/foundation-models/quickstart/yandexgpt
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_MODEL=yandexgpt-lite

# Порядок fallback между LLM-провайдерами.
# Провайдер без настроенного ключа или недоступный будет пропущен автоматически.
# Пример: сначала Yandex, потом локальная Ollama, затем Anthropic/Gemini.
LLM_FALLBACK_ORDER=yandex,ollama,anthropic,gemini

# Risk settings
MAX_POSITION_PCT=2.0
MAX_OPEN_POSITIONS=15
# Max position value as % of equity. Prevents over-concentration in one ticker.
MAX_POSITION_SIZE_PCT=5.0
# Min position value as % of equity. Filters out tiny/test positions.
MIN_POSITION_SIZE_PCT=0.5
STOP_LOSS_ATR_MULT=2.0
# ATR multiplier for trailing stop-loss. Initial stop uses STOP_LOSS_ATR_MULT;
# this governs how stop is trailed behind favourable daily closes.
TRAILING_STOP_ATR_MULT=2.5

# Liquidity filter: minimum average daily volume (in lots) for a ticker to be considered.
# Stocks with 20-day average volume below this threshold get heavily penalized in scoring.
MIN_AVG_VOLUME=100000

# Intraday signal filter (minimum viable filter — full complex filter will be added later)
INTRADAY_MIN_FACTORS=2          # how many confirming factors a directional signal must have
INTRADAY_MIN_VOLUME_RATIO=1.0   # minimum volume vs 20-period average to accept a signal
INTRADAY_COOLDOWN_MINUTES=30    # ignore repeated directional signals for the same ticker within this window

# Broker commission estimator (used by paper/real trading before opening a trade).
# DEFAULT_BROKER_COMMISSION_PCT is the round-trip commission % of turnover.
# For T-Bank "Трейдер" tariff 0.05% per side -> 0.1% round-trip.
DEFAULT_BROKER_COMMISSION_PCT=0.1

# Minimum net profit % after fees for a trade to be considered worth executing.
# With 10k RUB capital and 0.1% round-trip commission a 0.5% gross move leaves ~0.4% net.
MIN_PROFIT_PCT_AFTER_FEES=0.5

# Overnight carry fee model. By default the fixed T-Bank "Trader" tier fee is used.
# Set OVERNIGHT_CARRY_FEE_PCT to a non-zero value to switch to a percentage model.
OVERNIGHT_CARRY_FEE_PCT=0.0

# Tinkoff Invest API broker settings.
# Put the real token in .env.tinkoff (git-ignored) or set it directly here.
TINKOFF_TOKEN=
TINKOFF_ACCOUNT_ID=2224107441

# Trading mode: paper = virtual trades only (default for safety);
# semi-auto = robot proposes trades, you confirm before execution;
# live = robot executes real orders automatically (requires full-access token).
PAPER_TRADING=true
SEMI_AUTO_TRADING=true

# Virtual paper account size (rubles). Default is 50,000 for realistic testing.
PAPER_STARTING_CAPITAL=50000

# Master switch for automatic position opening. Can be toggled at runtime via Web UI/API.
# When false, the robot only creates proposals and waits for user confirmation.
AUTO_TRADING_ENABLED=true

# Health / web UI endpoint
HEALTH_PORT=8080
HOST=127.0.0.1

# Web UI — отключена по умолчанию, пока веб-панель не доработана
WEB_UI_ENABLED=false

# API key для защиты write-эндпоинтов, когда веб-UI включён.
# Сгенерируй случайную строку, например: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=6901

# CodeAct — выполнение Python-кода из ответов LLM. По умолчанию выключен.
# Включай только на локальном ПК; на сервере оставь false.
CODEACT_ENABLED=false

# Tinkoff sandbox starting capital (rubles). Only used when TINKOFF_SANDBOX=true.
SANDBOX_STARTING_CAPITAL=50000

# Central Bank of Russia key-rate meeting dates (ISO, comma-separated).
# On the meeting day and one trading day before, new positions are blocked
# and profit protection is tightened. Official 2026 schedule:
# 9 Feb, 23 Mar, 27 Apr, 15 Jun, 27 Jul, 14 Sep, 26 Oct, 14 Dec.
CBR_MEETING_DATES=2026-02-09,2026-03-23,2026-04-27,2026-06-15,2026-09-14,2026-10-26,2026-12-14
CBR_SOFT_MODE_ENABLED=true
